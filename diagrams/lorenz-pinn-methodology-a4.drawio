        <mxCell id="e12" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#667085;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;fontFamily=Arial;fontSize=9;fontStyle=1;fontColor=#344054;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="finalGate" target="evaluation"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="405" y="951"/></Array></mxGeometry></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#667085;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="evaluation" target="report"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="loopAdam" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#C65D5D;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="stageGate" target="causal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="38" y="656"/><mxPoint x="38" y="471"/></Array></mxGeometry></mxCell>
        <mxCell id="loopEpsilon" value="advance epsilon" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#C65D5D;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;fontFamily=Arial;fontSize=9;fontStyle=1;fontColor=#A64B4B;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1" source="nextEpsilon" target="causal"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="750" y="743"/><mxPoint x="750" y="471"/></Array></mxGeometry></mxCell>
        <mxCell id="loopWindow" value="next window" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#C65D5D;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;fontFamily=Arial;fontSize=9;fontStyle=1;fontColor=#A64B4B;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1" source="handoff" target="arch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="903"/><mxPoint x="760" y="257"/></Array></mxGeometry></mxCell>

        <mxCell id="title" value="&lt;b&gt;Lorenz-1960 PINN: Training and Evaluation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#DCE6F2&quot;&gt;27 sequential windows • causal weighting • hard initial condition&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#17365D;strokeColor=#17365D;strokeWidth=1.5;fontFamily=Arial;fontSize=19;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="20" width="654" height="56" as="geometry"/></mxCell>
        <mxCell id="noAdamLabel" value="NO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontFamily=Arial;fontSize=9;fontStyle=1;fontColor=#A64B4B;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="42" y="615" width="27" height="18" as="geometry"/></mxCell>
        <mxCell id="setup" value="&lt;b&gt;1  Problem setup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;x' = −0.1yz,  y' = 1.6xz,  z' = −0.75xy  •  u₀ = (0.5, 0.75, 1.0)&lt;br&gt;t ∈ [0, 13.26446]  •  float64  •  27 equal windows  •  1536 points/window&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FBE2D5;strokeColor=#A86F57;strokeWidth=1.6;fontFamily=Arial;fontSize=13;fontColor=#172033;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="70" y="92" width="654" height="75" as="geometry"/></mxCell>

        <mxCell id="arch" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDF3FC;strokeColor=#667085;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="70" y="185" width="654" height="145" as="geometry"/></mxCell>
        <mxCell id="archTitle" value="&lt;b&gt;2  PINN for each time window&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontColor=#172033;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="192" width="614" height="25" as="geometry"/></mxCell>
        <mxCell id="input" value="&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;time t&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#D9E8FB;strokeColor=#5F78A3;strokeWidth=1.4;fontFamily=Arial;fontSize=12;fontColor=#172033;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="86" y="229" width="82" height="72" as="geometry"/></mxCell>
        <mxCell id="hidden" value="&lt;b&gt;Hidden layers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;4 × 60 neurons&lt;br&gt;tanh&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#D9E8FB;strokeColor=#5F78A3;strokeWidth=1.4;fontFamily=Arial;fontSize=12;fontColor=#172033;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="183" y="229" width="178" height="72" as="geometry"/></mxCell>
        <mxCell id="output" value="&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Nₖ(t) ∈ ℝ³&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#D9E8FB;strokeColor=#5F78A3;strokeWidth=1.4;fontFamily=Arial;fontSize=12;fontColor=#172033;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="376" y="229" width="104" height="72" as="geometry"/></mxCell>
        <mxCell id="trial" value="&lt;b&gt;Hard initial condition&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;uₖ(t) = uₖ,₀ + (t − tₖ)Nₖ(t)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=9;fillColor=#D9E8FB;strokeColor=#5F78A3;strokeWidth=1.4;fontFamily=Arial;fontSize=12;fontColor=#172033;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="495" y="229" width="211" height="72" as="geometry"/></mxCell>
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5F78A3;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1" source="input" target="hidden"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5F78A3;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1" source="hidden" target="output"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5F78A3;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;" edge="1" parent="1" source="output" target="trial"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="residual" value="&lt;b&gt;3  ODE residual&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rₖ(t) = duₖ/dt − f(uₖ(t))  •  derivatives from automatic differentiation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EADCF7;strokeColor=#8064A2;strokeWidth=1.6;fontFamily=Arial;fontSize=13;fontColor=#172033;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="70" y="350" width="654" height="65" as="geometry"/></mxCell>
        <mxCell id="causal" value="&lt;b&gt;4  Causal residual loss&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Lᵢ = mean(rᵢ²)  •  wᵢ = exp[−ε Σⱼ&amp;lt;i Lⱼ]  •  L = mean(wᵢLᵢ)&lt;br&gt;ε: 0.01 → 0.1 → 1 → 10&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EADCF7;strokeColor=#8064A2;strokeWidth=1.6;fontFamily=Arial;fontSize=13;fontColor=#172033;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="70" y="430" width="654" height="82" as="geometry"/></mxCell>
        <mxCell id="adam" value="&lt;b&gt;5  Adam optimization&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;StepLR: learning rate × 0.9 every 1000 steps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F7D7D5;strokeColor=#A35C5C;strokeWidth=1.6;fontFamily=Arial;fontSize=13;fontColor=#172033;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="70" y="528" width="654" height="68" as="geometry"/></mxCell>

        <mxCell id="stageGate" value="&lt;b&gt;Stage complete?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;min(w) &gt; 0.99&lt;br&gt;or 4000 steps&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2B8;strokeColor=#8A7A43;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#172033;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="90" y="617" width="300" height="78" as="geometry"/></mxCell>
        <mxCell id="epsilonGate" value="&lt;b&gt;All ε values used?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2B8;strokeColor=#8A7A43;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#172033;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="450" y="617" width="230" height="78" as="geometry"/></mxCell>
        <mxCell id="lbfgs" value="&lt;b&gt;6  L-BFGS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;≤1000 iterations • unweighted residual MSE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F7D7D5;strokeColor=#A35C5C;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#172033;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="720" width="300" height="55" as="geometry"/></mxCell>
        <mxCell id="nextEpsilon" value="&lt;b&gt;Next ε&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;keep weights&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FBE2D5;strokeColor=#A86F57;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#172033;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="500" y="720" width="170" height="46" as="geometry"/></mxCell>
        <mxCell id="save" value="&lt;b&gt;7  Save window&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;checkpoint • history • prediction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F7D7D5;strokeColor=#A35C5C;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#172033;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="790" width="300" height="55" as="geometry"/></mxCell>
        <mxCell id="finalGate" value="&lt;b&gt;Last window?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;k = 27&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2B8;strokeColor=#8A7A43;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#172033;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="90" y="865" width="300" height="75" as="geometry"/></mxCell>
        <mxCell id="handoff" value="&lt;b&gt;Next window&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;uₖ₊₁,₀ = uₖ(tₖ₊₁)&lt;br&gt;copy weights • k ← k + 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D9F0E3;strokeColor=#5B8A72;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#172033;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="862" width="220" height="82" as="geometry"/></mxCell>
        <mxCell id="evaluation" value="&lt;b&gt;8  Reference evaluation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;DOP853 • 13,265 points • rtol = 10⁻¹⁰ • atol = 10⁻¹² • reference excluded from training&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCEBFA;strokeColor=#5F78A3;strokeWidth=1.6;fontFamily=Arial;fontSize=13;fontColor=#172033;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="70" y="965" width="654" height="70" as="geometry"/></mxCell>
        <mxCell id="report" value="&lt;b&gt;9  Evaluation outputs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MAE • RMSE • max error • residual MSE • invariant drift • training cost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#D9F0E3;strokeColor=#5B8A72;strokeWidth=1.6;fontFamily=Arial;fontSize=13;fontColor=#172033;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="70" y="1050" width="654" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
